# ISTORIK VIDEO FACTORY — секреты. Скопируйте в .env (программа сама создаст .env при первом запуске).
# Никогда не коммитьте .env в Git.

# Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
# Используется для: анализа тем, исследования, сценария, промтов, озвучки (TTS, голос Sadaltager),
# и как запасной генератор кадров, если Google Flow недоступен.
GEMINI_API_KEY=

# (необязательно) YouTube Data API v3 key — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Даёт точные данные о ваших видео и видео конкурентов. Без ключа используется RSS YouTube + поиск Google.
YOUTUBE_API_KEY=

# ---- Запасные источники (все необязательны; вводятся в панели: «Ключи» → «Другие сервисы») ----
# Groq — бесплатно ≈1 000 запросов/день: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter — бесплатные модели :free, 50/день (1 000/день после пополнения на 10 $): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral — бесплатный план Experiment: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Cerebras — пробные кредиты: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Gemini с оплатой (проект Google Cloud с Billing) — без дневных лимитов бесплатного тарифа, платно
GEMINI_PAID_API_KEY=
# Hugging Face — кадры FLUX.1 schnell по бесплатному кредиту: https://huggingface.co/settings/tokens
HF_TOKEN=
# Pollinations — необязательно, ускоряет бесплатные кадры: https://auth.pollinations.ai
POLLINATIONS_TOKEN=
